[Unit]
Description=Odonto Ramalho - Sistema de Gestao Odontologica
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/odonto-ramalho
ExecStart=/usr/bin/node dist/index.cjs
Restart=on-failure
RestartSec=10

# Environment variables
Environment=NODE_ENV=production
Environment=PORT=5000
# OBRIGATORIO: Adicione sua chave secreta abaixo (sem esta linha, o servico NAO inicia)
# Gere uma chave com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
EnvironmentFile=-/var/www/odonto-ramalho/.env

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=odonto-ramalho

[Install]
WantedBy=multi-user.target
