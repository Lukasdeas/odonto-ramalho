# ============================================
# Configuração Nginx para Odonto Ramalho
# ============================================
# Salve como: /etc/nginx/sites-available/odonto-ramalho
# Ative com: sudo ln -s /etc/nginx/sites-available/odonto-ramalho /etc/nginx/sites-enabled/
# Teste com: sudo nginx -t
# Recarregue com: sudo systemctl reload nginx

# Configuração para acesso via IP direto (sem domínio)
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    
    # Para usar com domínio específico, descomente e configure:
    # server_name seu-dominio.com.br www.seu-dominio.com.br;
    
    # Para IP direto, deixe sem server_name ou use:
    # server_name _;

    # ============================================
    # LOGS
    # ============================================
    access_log /var/log/nginx/odonto-ramalho-access.log combined;
    error_log /var/log/nginx/odonto-ramalho-error.log warn;

    # ============================================
    # SECURITY HEADERS
    # ============================================
    # Prevenir clickjacking
    add_header X-Frame-Options "SAMEORIGIN" always;
    
    # Prevenir MIME-type sniffing
    add_header X-Content-Type-Options "nosniff" always;
    
    # Ativar proteção XSS no navegador
    add_header X-XSS-Protection "1; mode=block" always;
    
    # Política de referrer
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    
    # Permissões do navegador
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    
    # Content Security Policy (ajuste conforme necessário)
    # add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self';" always;

    # ============================================
    # LIMITES E TIMEOUTS
    # ============================================
    # Limite de upload de arquivos
    client_max_body_size 10M;
    
    # Limite de tamanho do body
    client_body_buffer_size 10K;
    
    # Limite de tamanho de headers
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;
    
    # Timeouts
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    
    # Timeout de conexão do cliente
    client_body_timeout 12;
    client_header_timeout 12;
    keepalive_timeout 15;
    send_timeout 10;

    # ============================================
    # RATE LIMITING (adicional ao do aplicativo)
    # ============================================
    # Definir zona de rate limiting (adicione no bloco http do nginx.conf principal)
    # limit_req_zone $binary_remote_addr zone=api:10m rate=10r/s;
    # limit_req_zone $binary_remote_addr zone=login:10m rate=1r/s;
    
    # Aplicar rate limiting em rotas específicas
    # location /api/auth/ {
    #     limit_req zone=login burst=5 nodelay;
    #     proxy_pass http://127.0.0.1:5000;
    #     # ... demais configurações
    # }

    # ============================================
    # PROXY REVERSO PRINCIPAL
    # ============================================
    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        
        # Headers de proxy
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        
        # Buffering
        proxy_buffering on;
        proxy_buffer_size 4k;
        proxy_buffers 8 4k;
    }

    # ============================================
    # CACHE PARA ARQUIVOS ESTÁTICOS
    # ============================================
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        proxy_pass http://127.0.0.1:5000;
        proxy_cache_valid 200 1d;
        proxy_cache_use_stale error timeout http_500 http_502 http_503 http_504;
        expires 7d;
        add_header Cache-Control "public, immutable";
        
        # Manter headers de segurança
        add_header X-Content-Type-Options "nosniff" always;
    }

    # ============================================
    # WEBSOCKET (se necessário)
    # ============================================
    location /socket.io {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "Upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # ============================================
    # BLOQUEIOS DE SEGURANÇA
    # ============================================
    # Bloquear acesso a arquivos ocultos
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }

    # Bloquear arquivos de backup
    location ~ ~$ {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Bloquear acesso direto a .env
    location ~ \.env {
        deny all;
        access_log off;
        log_not_found off;
    }
    
    # Bloquear acesso a arquivos sensíveis
    location ~* \.(sql|sqlite|db|log|bak|old|backup)$ {
        deny all;
        access_log off;
        log_not_found off;
    }
}

# ============================================
# CONFIGURAÇÃO HTTPS (Com Let's Encrypt)
# ============================================
# Após configurar SSL com certbot, descomente e configure:

# Redirecionar HTTP para HTTPS
# server {
#     listen 80;
#     listen [::]:80;
#     server_name seu-dominio.com.br www.seu-dominio.com.br;
#     
#     # Permitir verificação do Let's Encrypt
#     location /.well-known/acme-challenge/ {
#         root /var/www/certbot;
#     }
#     
#     location / {
#         return 301 https://$server_name$request_uri;
#     }
# }

# Configuração HTTPS
# server {
#     listen 443 ssl http2;
#     listen [::]:443 ssl http2;
#     server_name seu-dominio.com.br www.seu-dominio.com.br;
#
#     # Certificados SSL (gerados pelo certbot)
#     ssl_certificate /etc/letsencrypt/live/seu-dominio.com.br/fullchain.pem;
#     ssl_certificate_key /etc/letsencrypt/live/seu-dominio.com.br/privkey.pem;
#     
#     # Configurações SSL modernas
#     ssl_protocols TLSv1.2 TLSv1.3;
#     ssl_prefer_server_ciphers off;
#     ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
#     
#     # HSTS (descomente após confirmar que HTTPS funciona)
#     # add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
#     
#     # Session tickets
#     ssl_session_timeout 1d;
#     ssl_session_cache shared:SSL:50m;
#     ssl_session_tickets off;
#     
#     # OCSP Stapling
#     ssl_stapling on;
#     ssl_stapling_verify on;
#     resolver 8.8.8.8 8.8.4.4 valid=300s;
#     resolver_timeout 5s;
#
#     # ... resto da configuração igual ao server HTTP acima ...
# }

# ============================================
# NOTAS DE SEGURANÇA
# ============================================
# 1. Sempre use HTTPS em produção
# 2. Configure firewall (UFW) para permitir apenas portas 22, 80, 443
# 3. Mantenha Nginx atualizado
# 4. Revise logs regularmente
# 5. Configure fail2ban para proteção contra brute force
# 6. Não exponha a porta 5000 publicamente
